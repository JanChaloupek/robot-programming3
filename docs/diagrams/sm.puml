@startuml sm
!theme plain
skinparam classAttributeIconSize 0

namespace utils {

    class Step {
        + name: str
        + autoNext: bool = True
        + __init__(name: str, tick_time: int)
    }

    class Task {
        + name: str
        + tickTime: int
        + autoNext: bool = False
        + id: int
        + __init__(name: str, tick_time: int)
    }

    class CPU {
        - {static} __NO: int
        - {static} __Q: dict
        + {static} add(sm: AbstractSM, cpu_no_parent: int) -> AbstractSM
        + {static} parentOf(cpu_no: int) -> AbstractSM | None
        + {static} remove(cpu_no: int)
        + {static} tick()
        + {static} existSM() -> bool
        + {static} clear()
    }

    abstract class AbstractSM {
        - _stack: list[Task]
        - _curTask: Task
        - _nextTask: Task
        - _period: Period
        + success: bool | None
        + cpu_no: int
        + __init__(tasks: list[Task], tick_time_default: int)
        + nextTask(task: Task)
        + endTask()
        + failureTask()
        + tick()
    }

    Task <|-- Step
    AbstractSM o-- Task : "zásobník úloh (_stack)"
    CPU o-- AbstractSM : "plánuje běžící automaty (__Q)"

    note bottom of CPU
        <b>Kooperativní dispečer CPU a stavový automat (SM) v balíčku utils</b>
        Původní architektura pro micro:bit: <b>Martin Dostál</b> (1. běh kurzu)
        Video: https://www.youtube.com/watch?v=NJkbWeEMMuw
        Úprava pro Pico:ed v2 a přímé přechody: <b>Jan Chaloupek</b>
    end note
}

namespace joycar {
    class CrossRoadsSM {
        - _robot: JoyCarRobot
        - _commands: Commands
        + __init__(robot: JoyCarRobot, commands: Commands)
    }

    utils.AbstractSM <|-- CrossRoadsSM
}

@enduml
